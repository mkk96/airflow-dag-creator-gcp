[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 120

[sqlfluff:templater:jinja]
# Disable dbt builtins (they define `var`, which clashes with Airflow's `var`).
apply_dbt_builtins = False
# Stubs for Airflow template objects (var.json.get(...)) used by generated SQL.
library_path = tests/sqlfluff_libs

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
# BigQuery pseudo-columns are conventionally upper case.
ignore_words = _PARTITIONTIME,_PARTITIONDATE,_TABLE_SUFFIX,_FILE_NAME

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

# Sample values so generated Jinja SQL renders for linting.
[sqlfluff:templater:jinja:context]
ds = 2024-01-15
ds_nodash = 20240115
ts = 2024-01-15T00:00:00+00:00
ts_nodash = 20240115T000000
data_interval_start = 2024-01-15T00:00:00+00:00
data_interval_end = 2024-01-16T00:00:00+00:00
cfg_var = dev_example
cfg = {"project_id": "my-project", "dataset": "my_dataset", "source_bucket": "my-bucket"}
params = {"table": "orders"}
